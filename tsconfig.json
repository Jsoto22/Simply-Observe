{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "module": "nodenext",
    "target": "es6",
    "lib": [
      "es6",
      "dom",
      "es2016",
      "es2017"
    ],
    "sourceMap": true,
    "allowJs": false,
    "declaration": true,
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "jest",
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tsup.config.js"
  ]
}